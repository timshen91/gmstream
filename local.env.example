# Copy to local.env and edit. Sourced by dev-ship.sh and gamescope/ship.sh.

# The build box: any Linux machine with podman (runs the gmstream-dev and
# gamescope-build containers).
build_host() { ssh -T user@build-box "$@"; }
# The SteamOS device.
device() { ssh deck@steamdeck.local "$@"; }
# Root on the device, for setcap after shipping. sudo -n needs a NOPASSWD
# rule; or feed the password here (local.env is not committed).
device_sudo() { device "sudo -n $*"; }
