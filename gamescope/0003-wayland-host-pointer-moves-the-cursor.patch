Wayland backend: host pointer motion moves the cursor, whatever the touch mode.

diff -ru a/src/Backends/WaylandBackend.cpp b/src/Backends/WaylandBackend.cpp
--- a/src/Backends/WaylandBackend.cpp	2026-10-26 17:19:37
+++ b/src/Backends/WaylandBackend.cpp	2026-10-26 17:19:41
@@ -3157,7 +3157,10 @@
         double flY = ( wl_fixed_to_double( fSurfaceY ) * uScale / 120.0 + oState->nDestY ) / g_nOutputHeight;
 
         wlserver_lock();
-        wlserver_touchmotion( flX, flY, 0, ++m_uFakeTimestamp );
+        // A host pointer is a mouse: move the cursor. wlserver_touchmotion
+        // follows the touch mode, and SteamOS's --default-touch-mode 4
+        // (passthrough) would turn this motion into touchscreen events.
+        wlserver_mousewarp_normalized( flX, flY, ++m_uFakeTimestamp );
         wlserver_unlock();
     }
     void CWaylandInputThread::Wayland_Pointer_Button( wl_pointer *pPointer, uint32_t uSerial, uint32_t uTime, uint32_t uButton, uint32_t uState )
diff -ru a/src/wlserver.cpp b/src/wlserver.cpp
--- a/src/wlserver.cpp	2026-10-26 17:19:39
+++ b/src/wlserver.cpp	2026-10-26 17:19:41
@@ -3289,6 +3289,29 @@
 	bump_input_counter();
 }
 
+void wlserver_mousewarp_normalized( double x, double y, uint32_t time )
+{
+	assert( wlserver_is_lock_held() );
+
+	if ( wlserver.mouse_focus_surface != NULL )
+	{
+		double tx = x * g_nOutputWidth;
+		double ty = y * g_nOutputHeight;
+		tx += focusedWindowOffsetX;
+		ty += focusedWindowOffsetY;
+		tx *= focusedWindowScaleX;
+		ty *= focusedWindowScaleY;
+
+		auto [nWidth, nHeight] = wlserver_get_cursor_bounds();
+		tx = clamp( tx, 0.0, nWidth - 0.1 );
+		ty = clamp( ty, 0.0, nHeight - 0.1 );
+
+		wlserver_mousewarp( tx, ty, time, false );
+	}
+
+	bump_input_counter();
+}
+
 void wlserver_touchdown( double x, double y, int touch_id, uint32_t time, gamescope::IBackendConnector* connector )
 {
 	assert( wlserver_is_lock_held() );
