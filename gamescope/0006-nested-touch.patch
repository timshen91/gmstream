+    // Touch
+
+    bool CWaylandInputThread::TouchPosition( wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY, double *pflX, double *pflY )
+    {
+        CWaylandPlane *pPlane = m_pTouchSurface ? (CWaylandPlane *)wl_surface_get_user_data( m_pTouchSurface ) : nullptr;
+        if ( !pPlane )
+            return false;
+
+        auto oState = pPlane->GetCurrentState();
+        if ( !oState )
+            return false;
+
+        // Normalized over the output, as for the pointer.
+        uint32_t uScale = oState->uFractionalScale;
+        *pflX = ( wl_fixed_to_double( fSurfaceX ) * uScale / 120.0 + oState->nDestX ) / g_nOutputWidth;
+        *pflY = ( wl_fixed_to_double( fSurfaceY ) * uScale / 120.0 + oState->nDestY ) / g_nOutputHeight;
+        return true;
+    }
+    void CWaylandInputThread::Wayland_Touch_Down( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, wl_surface *pSurface, int32_t nId, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY )
+    {
+        if ( !IsGamescopeToplevel( pSurface ) )
+            return;
+
+        m_pTouchSurface = pSurface;
+        double flX, flY;
+        if ( !TouchPosition( fSurfaceX, fSurfaceY, &flX, &flY ) )
+            return;
+
+        m_TouchesDown.insert( nId );
+        wlserver_lock();
+        wlserver_touchdown( flX, flY, nId, ++m_uFakeTimestamp );
         wlserver_unlock();
     }
+    void CWaylandInputThread::Wayland_Touch_Up( wl_touch *pTouch, uint32_t uSerial, uint32_t uTime, int32_t nId )
+    {
+        if ( !m_TouchesDown.erase( nId ) )
+            return;
 
+        wlserver_lock();
+        wlserver_touchup( nId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Motion( wl_touch *pTouch, uint32_t uTime, int32_t nId, wl_fixed_t fSurfaceX, wl_fixed_t fSurfaceY )
+    {
+        double flX, flY;
+        if ( !m_TouchesDown.count( nId ) || !TouchPosition( fSurfaceX, fSurfaceY, &flX, &flY ) )
+            return;
+
+        wlserver_lock();
+        wlserver_touchmotion( flX, flY, nId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+    }
+    void CWaylandInputThread::Wayland_Touch_Cancel( wl_touch *pTouch )
+    {
+        // wlserver has no cancel: every touch ends.
+        wlserver_lock();
+        for ( int32_t nId : m_TouchesDown )
+            wlserver_touchup( nId, ++m_uFakeTimestamp );
+        wlserver_unlock();
+        m_TouchesDown.clear();
+    }
+
