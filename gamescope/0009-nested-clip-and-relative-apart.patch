diff -ru a/src/steamcompmgr.cpp b/src/steamcompmgr.cpp
--- a/src/steamcompmgr.cpp	2026-11-01 17:00:54
+++ b/src/steamcompmgr.cpp	2026-11-02 20:30:21
@@ -2854,6 +2854,69 @@
 
 bool g_bFirstFrame = true;
 
+// Where the game with the input focus keeps the cursor, in output pixels: for a
+// host that draws the cursor itself, which sees only the finished image. Wine's
+// ClipCursor maps an override-redirect InputOnly window at the rectangle, which
+// Xwayland doesn't pass on (only that the pointer is confined); inside the game's
+// window is how Xwayland itself matches such a window to a surface. Any other
+// confinement or lock of the focused surface covers all of the window.
+//
+// The scale and offset are the base plane's, which wlserver_mousewarp_normalized
+// goes by the other way, so the edge of this is the edge of the clip for clicks.
+static gamescope::INestedHints::CursorClip gm_cursor_clip( global_focus_t *pFocus )
+{
+	gamescope::INestedHints::CursorClip clip;
+
+	steamcompmgr_win_t *w = pFocus->inputFocusWindow;
+	if ( !w || w->type != steamcompmgr_win_type_t::XWAYLAND || w == pFocus->overlayWindow || window_is_steam( w ) )
+		return clip;
+
+	const BaseLayerInfo_t &base = pFocus->CachedPlanes[ HELD_COMMIT_BASE ];
+	if ( base.windowScale[0] <= 0.0f || base.windowScale[1] <= 0.0f )
+		return clip;
+
+	const auto window = w->GetGeometry();
+	int32_t nLeft = 0, nTop = 0, nRight = window.nWidth, nBottom = window.nHeight;
+
+	for ( steamcompmgr_win_t *c = w->xwayland().ctx->list; c; c = c->xwayland().next )
+	{
+		const auto &a = c->xwayland().a;
+		if ( a.c_class != InputOnly || !a.override_redirect || a.map_state != IsViewable )
+			continue;
+
+		const int32_t nX = a.x - window.nX, nY = a.y - window.nY;
+		if ( nX < 0 || nY < 0 || nX + a.width > window.nWidth || nY + a.height > window.nHeight )
+			continue;
+
+		nLeft = nX;
+		nTop = nY;
+		nRight = nX + a.width;
+		nBottom = nY + a.height;
+		clip.bEnabled = true;
+		break;
+	}
+
+	if ( !clip.bEnabled )
+	{
+		wlserver_lock();
+		clip.bEnabled = wlserver.GetCursorConstraint() != nullptr;
+		wlserver_unlock();
+	}
+
+	if ( !clip.bEnabled )
+		return clip;
+
+	auto output = []( int32_t nGame, float flScale, float flOffset, uint32_t uSize ) {
+		return std::clamp<int32_t>( lroundf( nGame / flScale - flOffset ), 0, uSize );
+	};
+	clip.nLeft = output( nLeft, base.windowScale[0], base.windowOffset[0], currentOutputWidth );
+	clip.nTop = output( nTop, base.windowScale[1], base.windowOffset[1], currentOutputHeight );
+	clip.nRight = output( nRight, base.windowScale[0], base.windowOffset[0], currentOutputWidth );
+	clip.nBottom = output( nBottom, base.windowScale[1], base.windowOffset[1], currentOutputHeight );
+	clip.bEnabled = clip.nRight > clip.nLeft && clip.nBottom > clip.nTop;
+	return clip;
+}
