+// Lets held presented events go, one per refresh per window (cv_gm_throttle).
+static void gm_throttle_pump()
+{
+	static std::unordered_map<uint64_t, uint64_t> s_NextRelease;
+
+	// Frames ready but not shown yet, per window. Taken before wlserver_lock,
+	// as handle_done_commits takes this lock on its own.
+	std::unordered_map<uint64_t, int> waiting;
+	{
+		gamescope_xwayland_server_t *server = NULL;
+		for ( size_t i = 0; (server = wlserver_get_xwayland_server(i)); i++ )
+		{
+			std::lock_guard<std::mutex> lock( server->ctx->doneCommits.listCommitsDoneLock );
+			for ( const auto &entry : server->ctx->doneCommits.listCommitsDone )
+			{
+				if ( entry.fifo )
+					waiting[ entry.winSeq ]++;
+			}
+		}
+	}
+
+	wlserver_lock();
+	const uint64_t ulNow = get_time_in_nanos();
+	const uint64_t ulPeriod = g_SteamCompMgrLimitedAppRefreshCycle;
+	const uint64_t ulRefreshTime = g_SteamCompMgrVBlankTime.schedule.ulTargetVBlank;
+	uint64_t ulWake = 0;
+
+	for ( uint64_t ulWindow : wlserver_gm_held_windows() )
+	{
+		if ( !cv_gm_throttle )
+		{
+			while ( wlserver_gm_release_feedback( ulWindow, ulRefreshTime, g_SteamCompMgrLimitedAppRefreshCycle ) )
+				;
+			continue;
+		}
+
+		uint64_t &ulNext = s_NextRelease[ ulWindow ];
+		bool bMore = true;
+		if ( ulNow + 200'000 >= ulNext )
+		{
+			bMore = wlserver_gm_release_feedback( ulWindow, ulRefreshTime, g_SteamCompMgrLimitedAppRefreshCycle );
+			ulNext = ulNow + ulPeriod * ( waiting.contains( ulWindow ) ? 2 : 1 );
+
+			// Done a little before the latch is the aim. More than half a
+			// refresh early means it just missed one: that is late, not early.
+			auto iter = s_GmThrottleWait.find( ulWindow );
+			if ( iter != s_GmThrottleWait.end() && iter->second < ulPeriod )
+			{
+				int64_t lEarly = int64_t( iter->second );
+				if ( iter->second > ulPeriod / 2 )
+					lEarly -= int64_t( ulPeriod );
+				ulNext += ( lEarly - int64_t( k_ulGmThrottleLeadNs ) ) / 4;
+			}
+		}
+		if ( bMore && ( !ulWake || ulNext < ulWake ) )
+			ulWake = ulNext;
+	}
+	wlserver_unlock();
+
+	if ( ulWake )
+		g_GmThrottleTimer.ArmTimer( ulWake );
+
+	// Windows come and go: this only ever holds a handful.
+	if ( s_NextRelease.size() > 64 )
+	{
+		s_NextRelease.clear();
+		s_GmThrottleWait.clear();
+	}
+}
