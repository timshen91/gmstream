+struct GmHeldFeedback
+{
+	struct wl_resource *resource;
+	uint64_t ulWindow;
+	struct wl_listener destroyed;
+};
+
+static std::map<uint64_t, std::deque<GmHeldFeedback *>> s_GmHeldFeedback;
+static uint64_t s_ulGmFeedbackSequence = 0;
+
+static void gm_held_feedback_erase( GmHeldFeedback *pHeld )
+{
+	auto iter = s_GmHeldFeedback.find( pHeld->ulWindow );
+	if ( iter != s_GmHeldFeedback.end() )
+	{
+		std::erase( iter->second, pHeld );
+		if ( iter->second.empty() )
+			s_GmHeldFeedback.erase( iter );
+	}
+	wl_list_remove( &pHeld->destroyed.link );
+	delete pHeld;
+}
+
+static void gm_held_feedback_destroyed( struct wl_listener *pListener, void *pData )
+{
+	GmHeldFeedback *pHeld = wl_container_of( pListener, pHeld, destroyed );
+	gm_held_feedback_erase( pHeld );
+}
+
+void wlserver_gm_hold_feedback( uint64_t ulWindow, std::vector<struct wl_resource*>& presentation_feedbacks )
+{
+	for ( struct wl_resource *pResource : presentation_feedbacks )
+	{
+		GmHeldFeedback *pHeld = new GmHeldFeedback{ .resource = pResource, .ulWindow = ulWindow };
+		pHeld->destroyed.notify = gm_held_feedback_destroyed;
+		wl_resource_add_destroy_listener( pResource, &pHeld->destroyed );
+		s_GmHeldFeedback[ ulWindow ].push_back( pHeld );
+	}
+	presentation_feedbacks.clear();
+}
+
+bool wlserver_gm_release_feedback( uint64_t ulWindow, uint64_t last_refresh_nsec, uint64_t refresh_cycle )
+{
+	auto iter = s_GmHeldFeedback.find( ulWindow );
+	if ( iter == s_GmHeldFeedback.end() )
+		return false;
+
+	GmHeldFeedback *pHeld = iter->second.front();
+	struct wl_resource *pResource = pHeld->resource;
+	gm_held_feedback_erase( pHeld );
+
+	uint64_t ulSequence = ++s_ulGmFeedbackSequence;
+	timespec last_refresh_ts;
+	last_refresh_ts.tv_sec = time_t(last_refresh_nsec / 1'000'000'000ul);
+	last_refresh_ts.tv_nsec = long(last_refresh_nsec % 1'000'000'000ul);
+	wp_presentation_feedback_send_presented(
+		pResource,
+		last_refresh_ts.tv_sec >> 32,
+		last_refresh_ts.tv_sec & 0xffffffff,
+		last_refresh_ts.tv_nsec,
+		uint32_t(refresh_cycle),
+		ulSequence >> 32,
+		ulSequence & 0xffffffff,
+		WP_PRESENTATION_FEEDBACK_KIND_VSYNC | WP_PRESENTATION_FEEDBACK_KIND_HW_CLOCK | WP_PRESENTATION_FEEDBACK_KIND_ZERO_COPY );
+	wl_resource_destroy( pResource );
+	return s_GmHeldFeedback.contains( ulWindow );
+}
+
+std::vector<uint64_t> wlserver_gm_held_windows()
+{
+	std::vector<uint64_t> windows;
+	for ( const auto &entry : s_GmHeldFeedback )
+		windows.push_back( entry.first );
+	return windows;
+}
