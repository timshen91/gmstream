# Build environment for gmstream. Debian trixie's glibc (2.41) is older than
# SteamOS's, so the binary built here runs on the host directly.
FROM docker.io/library/debian:trixie
RUN apt-get update && apt-get install -y --no-install-recommends \
		build-essential pkg-config meson ninja-build cmake nasm git curl ca-certificates \
		python3 bison flex libexpat1-dev libffi-dev xkb-data \
		libegl-dev libgles-dev libgbm-dev libpipewire-0.3-dev \
	&& rm -rf /var/lib/apt/lists/*
COPY deps.sh pyrowave.sh /
RUN sh /deps.sh && sh /pyrowave.sh
RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable
ENV PATH=/root/.cargo/bin:$PATH \
	PKG_CONFIG_PATH=/opt/gm/lib/pkgconfig:/opt/gm/share/pkgconfig \
	CARGO_TARGET_DIR=/src/target
WORKDIR /src
