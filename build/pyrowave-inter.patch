diff --git a/shaders/inter_decide.comp b/shaders/inter_decide.comp
new file mode 100644
index 0000000..c71a808
--- /dev/null
+++ b/shaders/inter_decide.comp
@@ -0,0 +1,81 @@
+#version 450
+// Inter frames: per 32x32 luma block, whether to predict from the reference
+// (through the motion field). Predict when the residual's absolute sum is no larger than the block's own
+// absolute deviation from its mean, the intra cost proxy. Weight 1 predicts,
+// 0 codes the block intra (the DC shift).
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0) uniform mediump sampler2D uSource;
+layout(set = 0, binding = 1) writeonly uniform mediump image2D uWeights;
+layout(set = 0, binding = 2) uniform mediump sampler2D uReference;
+layout(set = 0, binding = 3) uniform isampler2D uVectors;
+#include "inter_motion.h"
+
+layout(push_constant) uniform Registers
+{
+    int refresh_period; // 0: off; else each block is coded intra once per this many frames
+    int refresh_phase; // the frame number modulo the period
+    int ref_y; // the stripe's first row in the reference
+};
+
+shared float s_a[64];
+shared float s_b[64];
+
+// Tree sum of each thread's a and b; every thread gets the totals.
+vec2 reduce2(float a, float b)
+{
+    uint t = gl_LocalInvocationIndex;
+    s_a[t] = a;
+    s_b[t] = b;
+    barrier();
+    for (uint s = 32u; s > 0u; s >>= 1u)
+    {
+        if (t < s)
+        {
+            s_a[t] += s_a[t + s];
+            s_b[t] += s_b[t + s];
+        }
+        barrier();
+    }
+    vec2 r = vec2(s_a[0], s_b[0]);
+    barrier();
+    return r;
+}
+
+void main()
+{
+    ivec2 size = textureSize(uSource, 0);
+    uint t = gl_LocalInvocationIndex;
+    // Thread t: row t / 2 of the block, 16 pixels from column (t % 2) * 16.
+    ivec2 p0 = ivec2(gl_WorkGroupID.xy) * 32 + ivec2(int(t & 1u) * 16, int(t >> 1));
+    float vals[16];
+    float sum = 0.0, sad = 0.0, n = 0.0;
+    // The 16 pixels span two vector cells: 0-7 and 8-15.
+    MotionCell mc0 = motion_cell(p0, 16.0), mc1 = motion_cell(p0 + ivec2(8, 0), 16.0);
+    for (int i = 0; i < 16; i++)
+    {
+        ivec2 p = p0 + ivec2(i, 0);
+        bool inside = all(lessThan(p, size));
+        float s = inside ? texelFetch(uSource, p, 0).x : 0.0;
+        vec2 v = i < 8 ? motion_in_cell(mc0, ivec2(i, 0)) : motion_in_cell(mc1, ivec2(i - 8, 0));
+        float r = inside ? sample_reference(vec2(p) + v, ref_y) : 0.0;
+        vals[i] = s;
+        sum += s;
+        sad += abs(s - r);
+        n += inside ? 1.0 : 0.0;
+    }
+    vec2 sn = reduce2(sum, n);
+    float mean = sn.x / max(sn.y, 1.0);
+    float dev = 0.0;
+    for (int i = 0; i < 16; i++)
+        if (all(lessThan(p0 + ivec2(i, 0), size)))
+            dev += abs(vals[i] - mean);
+    vec2 cost = reduce2(sad, dev);
+    if (t == 0u)
+    {
+        // Refresh: the blocks whose turn it is, scattered so no two neighbours go together.
+        ivec2 b = ivec2(gl_WorkGroupID.xy);
+        bool refresh = refresh_period > 0 && (b.x * 7 + b.y * 3) % refresh_period == refresh_phase;
+        imageStore(uWeights, b, vec4(cost.x <= cost.y && !refresh ? 1.0 : 0.0));
+    }
+}
diff --git a/shaders/inter_frame_mse.comp b/shaders/inter_frame_mse.comp
new file mode 100644
index 0000000..5c98f3d
--- /dev/null
+++ b/shaders/inter_frame_mse.comp
@@ -0,0 +1,42 @@
+#version 450
+// Inter frames: last frame's luma reconstruction error, the reference (its
+// decode) against its source, summed into a counter. It prices a bit for the
+// vector decision (inter_vector_rd.comp). One threadgroup per 32x32 pixels.
+layout(local_size_x = 64) in;
+
+layout(set = 0, binding = 0) buffer Stats
+{
+    uint sse_256; // squared 8-bit error over the frame, in units of 256
+} stats;
+layout(set = 0, binding = 1) uniform mediump sampler2D uReference;
+layout(set = 0, binding = 2) uniform mediump sampler2D uLastSource;
+
+shared uint s_sum[64];
+
+void main()
+{
+    ivec2 size = textureSize(uReference, 0);
+    uint t = gl_LocalInvocationIndex;
+    // Thread t: row t / 2 of the block, 16 pixels from column (t % 2) * 16.
+    ivec2 p0 = ivec2(gl_WorkGroupID.xy) * 32 + ivec2(int(t & 1u) * 16, int(t >> 1));
+    uint sum = 0u;
+    for (int i = 0; i < 16; i++)
+    {
+        ivec2 p = p0 + ivec2(i, 0);
+        if (all(lessThan(p, size)))
+        {
+            int d = int(texelFetch(uReference, p, 0).x * 255.0 + 0.5) - int(texelFetch(uLastSource, p, 0).x * 255.0 + 0.5);
+            sum += uint(d * d);
+        }
+    }
+    s_sum[t] = sum;
+    barrier();
+    for (uint s = 32u; s > 0u; s >>= 1u)
+    {
+        if (t < s)
+            s_sum[t] += s_sum[t + s];
+        barrier();
+    }
+    if (t == 0u)
+        atomicAdd(stats.sse_256, (s_sum[0] + 128u) >> 8);
+}
diff --git a/shaders/inter_motion.h b/shaders/inter_motion.h
new file mode 100644
index 0000000..3e92b84
--- /dev/null
+++ b/shaders/inter_motion.h
@@ -0,0 +1,67 @@
+// Inter frames: motion. One vector per 16x16 luma block, quarter pel, in
+// uVectors (RG16 signed). The vector at a pixel is bilinear between block
+// centres (8x8 blocks of 4:2:0 chroma, half the displacement), so the field is
+// smooth and the prediction has no block edges.
+#ifndef INTER_MOTION_H_
+#define INTER_MOTION_H_
+
+// Reference sample at pixel position q (texel index space), bilinear. A
+// stripe of the frame (coded as its own image) predicts from the whole
+// reference: ref_y is the stripe's first row in it.
+float sample_reference(vec2 q, int ref_y)
+{
+    q.y += float(ref_y);
+    vec2 fl = floor(q), f = q - fl;
+    vec4 t = textureGather(uReference, (fl + 1.0) / vec2(textureSize(uReference, 0))).wzxy;
+    return mix(mix(t.x, t.y, f.x), mix(t.z, t.w, f.x), f.y);
+}
+
+// Displacement in the plane's pixels at pixel p; vbs is the plane's vector
+// block size (16 luma, 8 for 4:2:0 chroma).
+vec2 motion_at(ivec2 p, float vbs)
+{
+    ivec2 gsize = textureSize(uVectors, 0);
+    vec2 g = (vec2(p) + 0.5) / vbs - 0.5;
+    ivec2 i0 = ivec2(floor(g));
+    vec2 f = g - vec2(i0);
+    ivec2 a = clamp(i0, ivec2(0), gsize - 1), b = clamp(i0 + 1, ivec2(0), gsize - 1);
+    vec2 v00 = vec2(texelFetch(uVectors, a, 0).xy), v10 = vec2(texelFetch(uVectors, ivec2(b.x, a.y), 0).xy);
+    vec2 v01 = vec2(texelFetch(uVectors, ivec2(a.x, b.y), 0).xy), v11 = vec2(texelFetch(uVectors, b, 0).xy);
+    return mix(mix(v00, v10, f.x), mix(v01, v11, f.x), f.y) * (vbs / 64.0);
+}
+
+// The four vectors around pixel p and p's position between them, for callers
+// that interpolate several neighbouring pixels from the same cell (an even
+// aligned 2x2 never straddles two cells).
+struct MotionCell
+{
+    vec2 v00, v10, v01, v11;
+    vec2 f;
+    float vbs;
+};
+
+MotionCell motion_cell(ivec2 p, float vbs)
+{
+    MotionCell c;
+    ivec2 gsize = textureSize(uVectors, 0);
+    vec2 g = (vec2(p) + 0.5) / vbs - 0.5;
+    ivec2 i0 = ivec2(floor(g));
+    c.f = g - vec2(i0);
+    ivec2 a = clamp(i0, ivec2(0), gsize - 1), b = clamp(i0 + 1, ivec2(0), gsize - 1);
+    float s = vbs / 64.0;
+    c.v00 = vec2(texelFetch(uVectors, a, 0).xy) * s;
+    c.v10 = vec2(texelFetch(uVectors, ivec2(b.x, a.y), 0).xy) * s;
+    c.v01 = vec2(texelFetch(uVectors, ivec2(a.x, b.y), 0).xy) * s;
+    c.v11 = vec2(texelFetch(uVectors, b, 0).xy) * s;
+    c.vbs = vbs;
+    return c;
+}
+
+// The displacement at p + o, o a small offset within the same cell.
+vec2 motion_in_cell(MotionCell c, ivec2 o)
+{
+    vec2 f = c.f + vec2(o) / c.vbs;
+    return mix(mix(c.v00, c.v10, f.x), mix(c.v01, c.v11, f.x), f.y);
+}
+
+#endif
diff --git a/shaders/inter_predict.comp b/shaders/inter_predict.comp
new file mode 100644
index 0000000..9809bb8
--- /dev/null
+++ b/shaders/inter_predict.comp
@@ -0,0 +1,33 @@
+#version 450
+// Inter frames: the prediction of one plane (inter_predict.h, exact integer
+// arithmetic), written as 8 bits. The forward transform subtracts it from the
+// source where intra frames subtract 0.5, and the inverse adds it back.
+layout(local_size_x = 8, local_size_y = 8) in;
+
+layout(set = 0, binding = 0) uniform mediump sampler2D uReference;
+layout(set = 0, binding = 1) writeonly uniform mediump image2D uPrediction;
+layout(set = 0, binding = 2) uniform mediump sampler2D uWeights;
+layout(set = 0, binding = 3) uniform isampler2D uVectors;
+
+layout(push_constant) uniform Registers
+{
+    int ref_y; // a stripe's first row in the reference, in this plane's rows
+};
+
+#include "inter_predict.h"
+
+// One thread per 2x2 pixels.
+void main()
+{
+    ivec2 size = imageSize(uPrediction);
+    ivec2 p = 2 * ivec2(gl_GlobalInvocationID.xy);
+    if (any(greaterThanEqual(p, size)))
+        return;
+    ivec4 pred = predict8_quad(p, ref_y);
+    for (int k = 0; k < 4; k++)
+    {
+        ivec2 o = ivec2(k & 1, k >> 1);
+        if (all(lessThan(p + o, size)))
+            imageStore(uPrediction, p + o, vec4(float(pred[k]) / 255.0));
+    }
+}
diff --git a/shaders/inter_predict.h b/shaders/inter_predict.h
new file mode 100644
index 0000000..e98ba99
--- /dev/null
+++ b/shaders/inter_predict.h
@@ -0,0 +1,99 @@
+// Inter frames: the prediction of one pixel, in integers so the encoder's
+// prediction pass and the decoder's inverse transform (which computes it in
+// place) agree exactly, on any GPU:
+//
+//   pred = 127.5 + w * (ref(p + d) - 127.5)    (8-bit units, rounded)
+//
+// w the block weights (32x32 luma blocks, 16x16 4:2:0 chroma; 0 or 1, bilinear
+// between block centres, 1/64 of a block), d the motion field (one quarter-pel
+// luma vector per 16x16, bilinear between block centres, half the
+// displacement in 4:2:0 chroma), ref the reference sampled bilinearly at 1/64
+// pel. Weight 0 is the intra DC shift.
+//
+// The includer declares uReference (R8, mirror-repeat sampler), uWeights
+// (R8) and uVectors (RG16 signed). A reference texel's position is clamped by
+// the sampler's mirror repeat (at the reference's edges, a stripe's too), so
+// p itself may lie past the plane's edge.
+#ifndef INTER_PREDICT_H_
+#define INTER_PREDICT_H_
+
+// An 8-bit texel's integer value (unorm reads are exact k / 255).
+int texel8(float v)
+{
+    return int(v * 255.0 + 0.5);
+}
+
+// A block weight texel (0 .. 255) on a 0 .. 256 scale, so that 1 is a power
+// of two: 0 and 255 map exactly to 0 and 1.
+int weight256(float v)
+{
+    int t = texel8(v);
+    return t + (t >> 7);
+}
+
+// Bilinear position of pixel p between block centres, blocks of 1 << shift:
+// g = (2p + 1 - block) / (2 block). The cell's lower corner, and the fraction
+// in 1 / (2 block) units. An even aligned pair of pixels never straddles two
+// cells (the corners fall between odd and even pixels).
+void cell(ivec2 p, int shift, out ivec2 i0, out ivec2 f)
+{
+    ivec2 n = 2 * p + 1 - (1 << shift);
+    i0 = n >> (shift + 1); // a floor for either sign
+    f = n - (i0 << (shift + 1));
+}
+
+// The predictions of the 2x2 pixels from p (even), as x = p, y = p + (1, 0),
+// z = p + (0, 1), w = p + (1, 1). p is in the plane being predicted, which is
+// a stripe of the frame starting at row ref_y of the reference (0 for a
+// whole frame); the weights and vectors are the stripe's own.
+ivec4 predict8_quad(ivec2 p, int ref_y)
+{
+    ivec2 size = textureSize(uReference, 0);
+    ivec2 wsize = textureSize(uWeights, 0), vsize = textureSize(uVectors, 0);
+    // Weight blocks are 32 luma pixels, so 16 in a half-width chroma plane;
+    // vector blocks are half that.
+    int wshift = size.x * 2 <= wsize.x * 32 ? 4 : 5;
+    int vshift = wshift - 1;
+
+    ivec2 vi, vf, wi, wf;
+    cell(p, vshift, vi, vf);
+    cell(p, wshift, wi, wf);
+    ivec2 a = clamp(vi, ivec2(0), vsize - 1), b = clamp(vi + 1, ivec2(0), vsize - 1);
+    ivec2 v00 = texelFetch(uVectors, a, 0).xy, v10 = texelFetch(uVectors, ivec2(b.x, a.y), 0).xy;
+    ivec2 v01 = texelFetch(uVectors, ivec2(a.x, b.y), 0).xy, v11 = texelFetch(uVectors, b, 0).xy;
+    a = clamp(wi, ivec2(0), wsize - 1);
+    b = clamp(wi + 1, ivec2(0), wsize - 1);
+    int w00 = weight256(texelFetch(uWeights, a, 0).x), w10 = weight256(texelFetch(uWeights, ivec2(b.x, a.y), 0).x);
+    int w01 = weight256(texelFetch(uWeights, ivec2(a.x, b.y), 0).x), w11 = weight256(texelFetch(uWeights, b, 0).x);
+    int D = 2 << vshift, E = 2 << wshift;
+
+    ivec4 result;
+    for (int k = 0; k < 4; k++)
+    {
+        ivec2 o = ivec2(k & 1, k >> 1);
+        ivec2 q = p + o;
+        // Each pixel step moves the fraction by 2 units.
+        ivec2 f = vf + 2 * o;
+        ivec2 v = (v00 * (D - f.x) + v10 * f.x) * (D - f.y) + (v01 * (D - f.x) + v11 * f.x) * f.y;
+        // v is quarter-pel luma times D^2; in this plane's pixels that is
+        // v / D^2 / 4 * block / 16, so at 1/64 pel v * block / D^2 = v / (4 block),
+        // rounded.
+        ivec2 d = ((q << 6) + ((v + (2 << vshift)) >> (vshift + 2)));
+        ivec2 ip = (d >> 6) + ivec2(0, ref_y), fq = d & 63;
+        vec4 t = textureGather(uReference, (vec2(ip) + 1.0) / vec2(size)).wzxy; // texels ip .. ip + 1, mirrored
+        int r = (texel8(t.x) * (64 - fq.x) + texel8(t.y) * fq.x) * (64 - fq.y)
+              + (texel8(t.z) * (64 - fq.x) + texel8(t.w) * fq.x) * fq.y; // x 4096
+        int r16 = (r + 128) >> 8; // 1/16 units, 0 .. 4080
+
+        f = wf + 2 * o;
+        int w = (w00 * (E - f.x) + w10 * f.x) * (E - f.y) + (w01 * (E - f.x) + w11 * f.x) * f.y;
+        int w8 = (w + (E * E >> 1)) >> (2 * wshift + 2); // 0 .. 256, 256 = 1
+
+        // pred16 = 2040 + w * (r16 - 2040), rounded; >> is a floor for either sign.
+        int pred16 = 2040 + ((w8 * (r16 - 2040) + 128) >> 8);
+        result[k] = clamp((pred16 + 8) >> 4, 0, 255);
+    }
+    return result;
+}
+
+#endif
diff --git a/shaders/inter_search.comp b/shaders/inter_search.comp
new file mode 100644
index 0000000..878ab6d
--- /dev/null
+++ b/shaders/inter_search.comp
@@ -0,0 +1,102 @@
+#version 450
+// Inter frames: one pass of 3-D recursive search for the 16x16 luma blocks'
+// vectors. Every block updates at once from the previous pass's field: it
+// keeps whichever of nine candidates (its current vector, zero, its vector
+// last frame, its four neighbours' current vectors, and two nudges of `step`)
+// gives the least SAD over a 2:1 subsampled block, plus a small pull toward its
+// neighbours' mean that keeps the field smooth.
+//
+// One thread per (block, candidate): each sums its candidate's 64 samples
+// alone, so the SAD needs no reduction across threads; the nine then meet once,
+// in shared memory, to pick the best. Eight blocks per threadgroup.
+layout(local_size_x = 72) in;
+const int NC = 9, BLOCKS = 8;
+
+layout(set = 0, binding = 0) uniform mediump sampler2D uSource;
+layout(set = 0, binding = 1) writeonly uniform iimage2D uOut;
+layout(set = 0, binding = 2) uniform mediump sampler2D uReference;
+layout(set = 0, binding = 3) uniform isampler2D uCur;
+layout(set = 0, binding = 4) uniform isampler2D uPrev;
+
+layout(push_constant) uniform Registers
+{
+    int step;       // quarter pel
+    int iteration;
+    float lambda;   // SAD units per quarter pel from the neighbours' mean
+    float zero_bias; // SAD units taken off the zero vector's cost
+    int ref_y;       // the stripe's first row in the reference (a stripe is coded as its own image)
+};
+
+// The reference through the sampler's own bilinear filter (bound linear):
+// the search only picks vectors, so it need not match the decoder's exact
+// interpolation, and a quarter-pel position is exact in the filter's weights.
+float search_sample(vec2 q)
+{
+    return textureLod(uReference, (q + vec2(0.5, 0.5 + float(ref_y))) / vec2(textureSize(uReference, 0)), 0.0).x;
+}
+
+shared float s_src[BLOCKS][64]; // each block's 2:1 subsampled source, read once
+shared float s_cost[BLOCKS][NC];
+shared ivec2 s_cand[BLOCKS][NC];
+
+void main()
+{
+    ivec2 gsize = textureSize(uCur, 0);
+    uint t = gl_LocalInvocationIndex;
+    uint b = t / uint(NC), k = t % uint(NC);
+    ivec2 blk = ivec2(gl_WorkGroupID.x * uint(BLOCKS) + b, gl_WorkGroupID.y);
+    bool live = blk.x < gsize.x;
+    blk.x = min(blk.x, gsize.x - 1);
+
+    ivec2 cur = texelFetch(uCur, blk, 0).xy;
+    ivec2 prev = texelFetch(uPrev, blk, 0).xy;
+    ivec2 n0 = texelFetch(uCur, clamp(blk + ivec2(-1, 0), ivec2(0), gsize - 1), 0).xy;
+    ivec2 n1 = texelFetch(uCur, clamp(blk + ivec2(1, 0), ivec2(0), gsize - 1), 0).xy;
+    ivec2 n2 = texelFetch(uCur, clamp(blk + ivec2(0, -1), ivec2(0), gsize - 1), 0).xy;
+    ivec2 n3 = texelFetch(uCur, clamp(blk + ivec2(0, 1), ivec2(0), gsize - 1), 0).xy;
+    int sgn = ((blk.x + blk.y + iteration) & 1) != 0 ? -1 : 1;
+    ivec2 c = k == 0u ? cur
+            : k == 1u ? ivec2(0)
+            : k == 2u ? prev
+            : k == 3u ? n0 : k == 4u ? n1 : k == 5u ? n2 : k == 6u ? n3
+            : k == 7u ? cur + ivec2(sgn * step, 0)
+            : cur + ivec2(0, sgn * step);
+    c = clamp(c, ivec2(-256), ivec2(256)); // +-64 pixels
+
+    ivec2 size = textureSize(uSource, 0);
+    for (uint j = t; j < uint(BLOCKS * 64); j += uint(BLOCKS * NC))
+    {
+        uint jb = j / 64u, js = j % 64u;
+        ivec2 sb = ivec2(min(gl_WorkGroupID.x * uint(BLOCKS) + jb, uint(gsize.x - 1)), gl_WorkGroupID.y);
+        s_src[jb][js] = texelFetch(uSource, min(sb * 16 + 2 * ivec2(int(js & 7u), int(js >> 3)), size - 1), 0).x;
+    }
+    barrier();
+    vec2 off = vec2(c) * 0.25;
+    float sad = 0.0;
+    for (int y = 0; y < 8; y++)
+        for (int x = 0; x < 8; x++)
+        {
+            ivec2 p = min(blk * 16 + 2 * ivec2(x, y), size - 1);
+            sad += abs(s_src[b][y * 8 + x] - search_sample(vec2(p) + off));
+        }
+    vec2 dv = abs(vec2(c) - vec2(n0 + n1 + n2 + n3) * 0.25);
+    sad += lambda * (dv.x + dv.y);
+    if (c == ivec2(0))
+        sad -= zero_bias;
+    s_cost[b][k] = sad;
+    s_cand[b][k] = c;
+    barrier();
+    if (k == 0u && live)
+    {
+        // The first of equal costs wins, in candidate order.
+        float best = s_cost[b][0];
+        ivec2 bv = s_cand[b][0];
+        for (int j = 1; j < NC; j++)
+            if (s_cost[b][j] < best)
+            {
+                best = s_cost[b][j];
+                bv = s_cand[b][j];
+            }
+        imageStore(uOut, blk, ivec4(bv, 0, 0));
+    }
+}
diff --git a/shaders/inter_side_cost.comp b/shaders/inter_side_cost.comp
new file mode 100644
index 0000000..055b512
--- /dev/null
+++ b/shaders/inter_side_cost.comp
@@ -0,0 +1,117 @@
+#version 450
+// Inter frames: the side information's size, charged to the rate control
+// before it resolves, so the whole frame (coefficients, and the inter packets
+// carrying the prediction map and the motion vectors) fits the target. One
+// threadgroup; each thread sizes 4x4 vector tiles' records as they are coded
+// (bitstream/inter.md, pyrowave_inter.cpp): a map bit per 32x32 block, per
+// component a 4-bit width, then each vector's zigzag delta from last frame's
+// at that width. Then one thread splits them into packets by the same rule as
+// inter_layout().
+//
+// First, a vector whose 32x32 weight block was decided intra is set to last
+// frame's, which costs nothing to send: its own value only reaches the
+// prediction in the blend toward its predicted neighbours. (Experiment knob:
+// FreeIntraVectors, default on.)
+layout(local_size_x = 256) in;
+layout(constant_id = 0) const bool FreeIntraVectors = true;
+
+layout(set = 0, binding = 4) buffer Buckets
+{
+    uint count;
+    uint consumed_payload; // u32 words, accumulated by analyze_rate_control
+} buckets;
+layout(set = 0, binding = 1, rg16i) uniform iimage2D uVectors;
+layout(set = 0, binding = 2) uniform isampler2D uVectorsPrev;
+layout(set = 0, binding = 3) uniform mediump sampler2D uWeights;
+
+layout(push_constant) uniform Registers
+{
+    uint packet_boundary; // bytes per inter packet at most
+};
+
+const int MaxTiles = 4096; // 5K; beyond, an estimate
+shared uint s_tile_bits[MaxTiles];
+
+shared uint s_bits[256];
+
+uint zigzag(int d)
+{
+    return d >= 0 ? uint(2 * d) : uint(-2 * d - 1);
+}
+
+void main()
+{
+    ivec2 size = imageSize(uVectors);
+    ivec2 tiles = (size + 3) / 4;
+    ivec2 msize = textureSize(uWeights, 0);
+    uint bits = 0u;
+    for (int t = int(gl_LocalInvocationIndex); t < tiles.x * tiles.y; t += 256)
+    {
+        ivec2 base = ivec2(t % tiles.x, t / tiles.x) * 4;
+        uvec2 mx = uvec2(0u);
+        int n = 0;
+        for (int y = base.y; y < min(base.y + 4, size.y); y++)
+            for (int x = base.x; x < min(base.x + 4, size.x); x++, n++)
+            {
+                ivec2 prev = texelFetch(uVectorsPrev, ivec2(x, y), 0).xy;
+                ivec2 v = imageLoad(uVectors, ivec2(x, y)).xy;
+                if (FreeIntraVectors && v != prev && texelFetch(uWeights, ivec2(x, y) / 2, 0).x == 0.0)
+                {
+                    v = prev;
+                    imageStore(uVectors, ivec2(x, y), ivec4(v, 0, 0));
+                }
+                ivec2 d = v - prev;
+                mx = max(mx, uvec2(zigzag(d.x), zigzag(d.y)));
+            }
+        uvec2 width = uvec2(findMSB(mx) + 1); // findMSB(0) is -1
+        ivec2 tm = min(ivec2(2), msize - (base / 2));
+        uint tb = uint(tm.x * tm.y) + 8u + uint(n) * (width.x + width.y);
+        if (t < MaxTiles)
+            s_tile_bits[t] = tb;
+        bits += tb;
+    }
+    s_bits[gl_LocalInvocationIndex] = bits;
+    barrier();
+    for (uint s = 128u; s > 0u; s >>= 1u)
+    {
+        if (gl_LocalInvocationIndex < s)
+            s_bits[gl_LocalInvocationIndex] += s_bits[gl_LocalInvocationIndex + s];
+        barrier();
+    }
+    if (gl_LocalInvocationIndex == 0u)
+    {
+        uint total = 0u;
+        int count = tiles.x * tiles.y;
+        if (count <= MaxTiles)
+        {
+            // Greedily in tile order, whole records per packet: 8 header bytes,
+            // the records padded to a word.
+            uint open_bits = 0u;
+            bool open = false;
+            for (int t = 0; t < count; t++)
+            {
+                uint b = s_tile_bits[t];
+                if (open && 8u + 4u * ((open_bits + b + 31u) / 32u) > packet_boundary)
+                {
+                    total += 8u + 4u * ((open_bits + 31u) / 32u);
+                    open = false;
+                }
+                if (!open)
+                {
+                    open_bits = 0u;
+                    open = true;
+                }
+                open_bits += b;
+            }
+            if (open)
+                total += 8u + 4u * ((open_bits + 31u) / 32u);
+        }
+        else
+        {
+            // Every packet at most a record (66 bytes) short of full.
+            uint bytes = (s_bits[0] + 7u) / 8u;
+            total = bytes + (bytes / max(packet_boundary - 80u, 1u) + 1u) * 80u;
+        }
+        atomicAdd(buckets.consumed_payload, (total + 3u) / 4u);
+    }
+}
diff --git a/shaders/inter_vector_rd.comp b/shaders/inter_vector_rd.comp
new file mode 100644
index 0000000..b6e0e81
--- /dev/null
+++ b/shaders/inter_vector_rd.comp
@@ -0,0 +1,100 @@
+#version 450
+// Inter frames: whether each 4x4 tile of vectors (64x64 luma) is worth its
+// bits. The tile keeps the searched vectors only if the prediction error they
+// save over last frame's vectors (which cost nothing to send) is worth more
+// than the bits they cost, at a price per bit from the rate-distortion slope:
+// a bit buys about 2 ln 2 times the mean squared error per pixel, measured on
+// last frame (inter_frame_mse.comp), times a calibration `scale`. Otherwise the
+// tile goes back to last frame's vectors.
+//
+// The error is over a 2:1 subsampled tile with each 16x16 block's own vector
+// (no interpolation between blocks): it only has to rank two choices. Vectors
+// under intra blocks are taken as last frame's first (they are set so by the
+// side-cost pass, inter_side_cost.comp), so their pixels count for nothing.
+layout(local_size_x = 256) in;
+
+layout(set = 0, binding = 6) readonly buffer Stats
+{
+    uint sse_256;
+} stats;
+layout(set = 0, binding = 1, rg16i) uniform iimage2D uVectors;
+layout(set = 0, binding = 2) uniform isampler2D uVectorsPrev;
+layout(set = 0, binding = 3) uniform mediump sampler2D uSource;
+layout(set = 0, binding = 4) uniform mediump sampler2D uReference; // bound with a bilinear sampler
+layout(set = 0, binding = 5) uniform mediump sampler2D uWeights;
+
+layout(push_constant) uniform Registers
+{
+    float scale; // the price's calibration; 0 turns the pass off
+};
+
+shared float s_d[256];
+shared ivec2 s_v[16], s_vp[16]; // the tile's vectors, searched and last frame's
+
+uint zigzag(int d)
+{
+    return d >= 0 ? uint(2 * d) : uint(-2 * d - 1);
+}
+
+void main()
+{
+    ivec2 vsize = imageSize(uVectors);
+    ivec2 size = textureSize(uSource, 0);
+    ivec2 tile = ivec2(gl_WorkGroupID.xy) * 4;
+    uint t = gl_LocalInvocationIndex;
+    if (t < 16u)
+    {
+        ivec2 vb = min(tile + ivec2(int(t & 3u), int(t >> 2)), vsize - 1);
+        s_vp[t] = texelFetch(uVectorsPrev, vb, 0).xy;
+        s_v[t] = texelFetch(uWeights, vb / 2, 0).x == 0.0 ? s_vp[t] : imageLoad(uVectors, vb).xy;
+    }
+    barrier();
+
+    // Thread t: four samples of the tile's 32x32 subsampled grid, in its block.
+    float dsse = 0.0; // error with the searched vectors minus with last frame's
+    for (int k = 0; k < 4; k++)
+    {
+        uint s = t * 4u + uint(k);
+        ivec2 g = ivec2(int(s & 31u), int(s >> 5)); // subsampled position in the tile
+        ivec2 p = tile * 16 + 2 * g;
+        ivec2 vb = tile + g / 8;
+        if (any(greaterThanEqual(p, size)) || any(greaterThanEqual(vb, vsize)))
+            continue;
+        int j = (g.y / 8) * 4 + g.x / 8;
+        vec2 inv = 1.0 / vec2(textureSize(uReference, 0));
+        float src = texelFetch(uSource, p, 0).x * 255.0;
+        float a = textureLod(uReference, (vec2(p) + vec2(s_v[j]) * 0.25 + 0.5) * inv, 0.0).x * 255.0;
+        float b = textureLod(uReference, (vec2(p) + vec2(s_vp[j]) * 0.25 + 0.5) * inv, 0.0).x * 255.0;
+        dsse += (src - a) * (src - a) - (src - b) * (src - b);
+    }
+    s_d[t] = dsse;
+    barrier();
+    for (uint s = 128u; s > 0u; s >>= 1u)
+    {
+        if (t < s)
+            s_d[t] += s_d[t + s];
+        barrier();
+    }
+
+    if (t == 0u && scale > 0.0)
+    {
+        // The searched vectors' bits over last frame's (8 bits of widths either way).
+        uvec2 mx = uvec2(0u);
+        int n = 0;
+        for (int y = tile.y; y < min(tile.y + 4, vsize.y); y++)
+            for (int x = tile.x; x < min(tile.x + 4, vsize.x); x++, n++)
+            {
+                int j = (y - tile.y) * 4 + (x - tile.x);
+                ivec2 d = s_v[j] - s_vp[j];
+                mx = max(mx, uvec2(zigzag(d.x), zigzag(d.y)));
+            }
+        float bits = float(n) * float(findMSB(mx.x) + 1 + findMSB(mx.y) + 1);
+        float mse = float(stats.sse_256) * 256.0 / float(size.x * size.y);
+        float price = scale * 1.386 * max(mse, 1.0);
+        // The error is over a quarter of the pixels.
+        if (4.0 * s_d[0] + price * bits >= 0.0)
+            for (int y = tile.y; y < min(tile.y + 4, vsize.y); y++)
+                for (int x = tile.x; x < min(tile.x + 4, vsize.x); x++)
+                    imageStore(uVectors, ivec2(x, y), ivec4(s_vp[(y - tile.y) * 4 + (x - tile.x)], 0, 0));
+    }
+}
