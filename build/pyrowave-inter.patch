+id<MTLTexture> create_weight_texture(pyrowave_device device, int width, int height)
+{
+	const int gw = (width + 31) / 32, gh = (height + 31) / 32;
+	auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR8Unorm
+	                                                               width:gw height:gh mipmapped:NO];
+	desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+	desc.storageMode = MTLStorageModeShared;
+	id<MTLTexture> texture = [device->mtl newTextureWithDescriptor:desc];
+	std::vector<uint8_t> ones(size_t(gw) * gh, 255);
+	[texture replaceRegion:MTLRegionMake2D(0, 0, gw, gh) mipmapLevel:0 withBytes:ones.data() bytesPerRow:gw];
+	return texture;
+}
+
+id<MTLTexture> create_vector_texture(pyrowave_device device, int width, int height)
+{
+	auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatRG16Sint
+	                                                               width:(width + 15) / 16
+	                                                              height:(height + 15) / 16 mipmapped:NO];
+	desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+	desc.storageMode = MTLStorageModeShared;
+	id<MTLTexture> texture = [device->mtl newTextureWithDescriptor:desc];
+	clear_vector_texture(texture);
+	return texture;
+}
+
+void clear_vector_texture(id<MTLTexture> texture)
+{
+	std::vector<int16_t> zero(texture.width * texture.height * 2, 0);
+	[texture replaceRegion:MTLRegionMake2D(0, 0, texture.width, texture.height) mipmapLevel:0
+	             withBytes:zero.data() bytesPerRow:texture.width * 4];
+}
+
+void dispatch_inter_predict(pyrowave_device device, id<MTLComputeCommandEncoder> enc,
+                            id<MTLTexture> const reference[3], int ref_y, int width, int height,
+                            id<MTLTexture> weights, id<MTLTexture> vectors,
+                            __strong id<MTLTexture> prediction[3])
+{
+	[enc setComputePipelineState:device->predict_pipeline];
+	[enc setTexture:weights atIndex:2];
+	[enc setTexture:vectors atIndex:3];
+	[enc setSamplerState:device->mirror_repeat_sampler atIndex:3];
+	[enc setSamplerState:device->mirror_repeat_sampler atIndex:0];
+	[enc setSamplerState:device->mirror_repeat_sampler atIndex:2];
+	for (int c = 0; c < 3; c++)
+	{
+		id<MTLTexture> ref = reference[c];
+		NSUInteger w = c ? width / 2 : width, h = c ? height / 2 : height;
+		if (!prediction[c] || prediction[c].width != w || prediction[c].height != h)
+		{
+			auto desc = [MTLTextureDescriptor texture2DDescriptorWithPixelFormat:MTLPixelFormatR8Unorm
+			                                                               width:w height:h mipmapped:NO];
+			desc.usage = MTLTextureUsageShaderRead | MTLTextureUsageShaderWrite;
+			desc.storageMode = MTLStorageModePrivate;
+			prediction[c] = [device->mtl newTextureWithDescriptor:desc];
+		}
+		const int32_t plane_y = c ? ref_y / 2 : ref_y;
+		[enc setBytes:&plane_y length:sizeof(plane_y) atIndex:0];
+		[enc setTexture:ref atIndex:0];
+		[enc setTexture:prediction[c] atIndex:1];
+		[enc dispatchThreadgroups:MTLSizeMake((w + 15) / 16, (h + 15) / 16, 1)
+		    threadsPerThreadgroup:MTLSizeMake(8, 8, 1)];
+	}
+}
+
+id<MTLComputePipelineState> create_dwt_pipeline(pyrowave_device device, id<MTLLibrary> library,
+                                                const char *entry_point, uint32_t required_threads,
+                                                int variant)
+{
+	MTLFunctionConstantValues *constants = [MTLFunctionConstantValues new];
+	bool dc_shift = variant == 1, predict = variant == 2;
+	[constants setConstantValue:&dc_shift type:MTLDataTypeBool atIndex:0];
+	[constants setConstantValue:&predict type:MTLDataTypeBool atIndex:2];
+	return create_pipeline(device, library, entry_point, required_threads, constants);
+}
+
