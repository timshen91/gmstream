+
+ImageHandle WaveletBuffers::create_inter_image(CommandBuffer &cmd, int w, int h, VkFormat format, const char *name)
+{
+	auto info = ImageCreateInfo::immutable_2d_image(w, h, format);
+	info.usage = VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_STORAGE_BIT |
+	             VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+	info.initial_layout = VK_IMAGE_LAYOUT_UNDEFINED;
+	info.layout = ImageLayout::General;
+	auto image = device->create_image(info);
+	if (!image)
+		return image;
+	device->set_name(*image, name);
+	cmd.image_barrier(*image, VK_IMAGE_LAYOUT_UNDEFINED, VK_IMAGE_LAYOUT_GENERAL,
+	                  VK_PIPELINE_STAGE_NONE, 0, VK_PIPELINE_STAGE_2_CLEAR_BIT, VK_ACCESS_TRANSFER_WRITE_BIT);
+	VkClearValue zero = {};
+	cmd.clear_image(*image, zero);
+	cmd.barrier(VK_PIPELINE_STAGE_2_CLEAR_BIT, VK_ACCESS_TRANSFER_WRITE_BIT,
+	            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT | VK_PIPELINE_STAGE_2_COPY_BIT,
+	            VK_ACCESS_2_SHADER_SAMPLED_READ_BIT | VK_ACCESS_2_SHADER_STORAGE_READ_BIT |
+	            VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT | VK_ACCESS_TRANSFER_READ_BIT | VK_ACCESS_TRANSFER_WRITE_BIT);
+	return image;
+}
+
+void WaveletBuffers::copy_rows(CommandBuffer &cmd, const ImageView &src, const ImageView &dst,
+                               int w, int h, int src_y, int dst_y)
+{
+	struct { int32_t w, h, src_y, dst_y; } push = {w, h, src_y, dst_y};
+	cmd.set_program(shaders.copy_rows);
+	cmd.set_texture(0, 0, src, *mirror_repeat_sampler);
+	cmd.set_storage_texture(0, 1, dst);
+	cmd.push_constants(&push, 0, sizeof(push));
+	cmd.dispatch((w + 7) / 8, (h + 7) / 8, 1);
+}
+
+void WaveletBuffers::inter_predict(CommandBuffer &cmd, const ViewBuffers &reference, int ref_y,
+                                   const ImageView &weights, const ImageView &vectors,
+                                   ImageHandle (&prediction)[NumComponents])
+{
+	cmd.set_program(shaders.inter_predict);
+	cmd.set_texture(0, 2, weights, *mirror_repeat_sampler);
+	cmd.set_texture(0, 3, vectors, *mirror_repeat_sampler);
+	for (int c = 0; c < NumComponents; c++)
+	{
+		const auto &ref = *reference.planes[c];
+		bool sub = c != 0 && chroma == ChromaSubsampling::Chroma420;
+		int w = sub ? width / 2 : width, h = sub ? height / 2 : height;
+		if (!prediction[c] || int(prediction[c]->get_width()) != w || int(prediction[c]->get_height()) != h)
+			prediction[c] = create_inter_image(cmd, w, h, VK_FORMAT_R8_UNORM, "inter-prediction");
+		const int32_t plane_y = sub ? ref_y / 2 : ref_y;
+		cmd.push_constants(&plane_y, 0, sizeof(plane_y));
+		cmd.set_texture(0, 0, ref, *mirror_repeat_sampler);
+		cmd.set_storage_texture(0, 1, prediction[c]->get_view());
+		cmd.dispatch((w + 15) / 16, (h + 15) / 16, 1);
+	}
+	cmd.barrier(VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_STORAGE_WRITE_BIT,
+	            VK_PIPELINE_STAGE_COMPUTE_SHADER_BIT, VK_ACCESS_2_SHADER_SAMPLED_READ_BIT);
+}
 }
