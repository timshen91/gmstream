#version 450
// Scanout compositor (compositor.cpp): Riptide's planes (YCbCr 4:2:0, BT.709,
// full range) to RGB, written into the buffer the panel reads next, turned to
// the panel's own orientation. One invocation per output pixel; a dispatch
// covers rows [origin.y, origin.y + its height) of the output.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D Y;
layout(set = 0, binding = 1) uniform sampler2D Cb;
layout(set = 0, binding = 2) uniform sampler2D Cr;
layout(set = 0, binding = 3, rgba8) uniform writeonly image2D dst;
layout(push_constant) uniform P { ivec2 size; ivec2 origin; vec2 scale; int rotation; } p;

vec2 source_uv(ivec2 px)
{
	vec2 q = (vec2(px) + 0.5) / vec2(p.size);
	// As yuv_r270.vert / yuv_r90.vert: the picture a quarter turn from the panel.
	vec2 uv = p.rotation == 1 ? vec2(q.y, 1.0 - q.x) : p.rotation == 3 ? vec2(1.0 - q.y, q.x) : q;
	return uv * p.scale;
}

void main()
{
	ivec2 px = ivec2(gl_GlobalInvocationID.xy) + p.origin;
	if (px.x >= p.size.x || px.y >= p.size.y)
		return;
	vec2 uv = source_uv(px);
	float y = textureLod(Y, uv, 0.0).r;
	float cb = textureLod(Cb, uv, 0.0).r - 0.5;
	float cr = textureLod(Cr, uv, 0.0).r - 0.5;
	imageStore(dst, px, vec4(y + 1.5748 * cr, y - 0.187324 * cb - 0.468124 * cr, y + 1.8556 * cb, 1.0));
}
